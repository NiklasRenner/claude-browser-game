{
  "name": "questforge",
  "version": "0.1.0",
  "private": true,
  "description": "A modern take on classic turn-based browser RPGs (in the spirit of AdventureQuest), rendered with three.js.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/lint.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:update-golden": "node scripts/update-golden.mjs",
    "test:e2e": "node scripts/build.mjs && node scripts/e2e.mjs",
    "sim": "tsx scripts/simulate.ts",
    "gallery": "node scripts/build.mjs && node scripts/gallery.mjs",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
